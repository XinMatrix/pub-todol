<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mainTopLL"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="?attr/myFirstColor"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mainInfoIV"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:contentDescription="Info"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info" />

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/myBackgroundColor"
                app:cardCornerRadius="5dp">

                <EditText
                    android:id="@+id/mainSearchET"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:autofillHints="Search"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:hint="搜索日期或笔记"
                    android:inputType="text"
                    android:textColorHint="?attr/myTextColor" />

            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/mainSettingsIV"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:contentDescription="Settings"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/mainListLL"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/myBackgroundColor">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mainRecycleView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#404040"
            android:gravity="center">

            <TextView
                android:id="@+id/textViewError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/tryAgain"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!--            android:textColor="?attr/myTextColor"-->

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/mySecondColor"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="10dp">

                <!--                    android:text="TODOL\n内测版"-->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="TODOL"
                    android:textColor="?attr/myTextColor"
                    android:textSize="50sp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="@string/introduce"
                    android:textColor="?attr/myTextColor"
                    android:textSize="16sp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="@string/useMethod"
                    android:textColor="?attr/myTextColor"
                    android:textSize="16sp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="@string/callback"
                    android:textColor="?attr/myTextColor"
                    android:textSize="16sp" />

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="325dp"
                        android:contentDescription="donate"
                        android:src="@drawable/wechat_pay" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/mainContactMeTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:gravity="center"
                android:text="@string/myPhone"
                android:textColor="?attr/myTextColor"
                android:textSize="16sp" />

        </LinearLayout>

    </ScrollView>

    <ScrollView
        android:id="@+id/mainEndSV"
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="?attr/mySecondColor"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--        悬浮窗归类-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="常规"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="152dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!--        悬浮窗开启、关闭-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="悬浮球"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <CheckBox
                            android:id="@+id/mainServiceCB"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="15dp"
                            android:buttonTint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        动画关闭开启、关闭-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="程序动画"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <CheckBox
                            android:id="@+id/mainAniCB"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="15dp"
                            android:buttonTint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        每天隐藏关闭开启、关闭-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="每日隐藏笔记"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <CheckBox
                            android:id="@+id/mainHintCB"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="15dp"
                            android:buttonTint="?attr/myTextColor" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!--            254很有意思-->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="407dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!--        悬浮窗宽度设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="窗体宽度"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainWidthLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainWidthTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="6"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainWidthNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        悬浮窗高度设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="窗体高度"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainHeightLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainHeightTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="5"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainHeightNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        悬浮窗透明度设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="窗体透明度"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainAlphaLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainAlphaTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="0.9"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainAlphaNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        按钮区高度设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="按钮区高度"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainButtonHeightLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainButtonHeightTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainButtonHeightNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        触控板高度设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="触控板高度"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainTouchHeightLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainTouchHeightTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainTouchHeightNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        输入框大小设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="输入字号"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainInputSizeLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainInputSizeTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainInputSizeNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        悬浮球大小设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="悬浮球大小"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainFloatSizeLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainFloatSizeTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="?attr/myTextColor"
                            android:textSize="25sp" />

                        <ImageView
                            android:id="@+id/mainFloatSizeNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        悬浮窗配色设置-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="15dp"
                            android:layout_weight="1"
                            android:gravity="start|center"
                            android:text="主题配色"
                            android:textColor="?attr/myTextColor"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mainThemeLastIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:contentDescription="Last"
                            android:rotation="180"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                        <TextView
                            android:id="@+id/mainThemeTV"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:text="绿色"
                            android:textColor="?attr/myTextColor"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/mainThemeNextIV"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="Next"
                            android:src="@drawable/ic_next"
                            app:tint="?attr/myTextColor" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!--        输入窗口位置复原-->
            <androidx.cardview.widget.CardView
                android:id="@+id/mainResetInputWindowsPositionCV"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="15dp"
                    android:gravity="start|center"
                    android:text="重置悬浮窗位置"
                    android:textColor="?attr/myTextColor"
                    android:textSize="20sp" />

            </androidx.cardview.widget.CardView>

            <!--        高级设置归类-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="高级"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <!--        查看统计数据-->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="101dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!--                    查看收藏笔记-->
                    <TextView
                        android:id="@+id/mainStarTV"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="15dp"
                        android:gravity="start|center"
                        android:text="查看收藏笔记"
                        android:textColor="?attr/myTextColor"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--                    笔记数据统计-->
                    <TextView
                        android:id="@+id/mainStatisticTV"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="15dp"
                        android:gravity="start|center"
                        android:text="笔记数据统计"
                        android:textColor="?attr/myTextColor"
                        android:textSize="20sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="101dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                app:cardBackgroundColor="?attr/myFirstColor"
                app:cardCornerRadius="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!--        导入笔记数据-->
                    <TextView
                        android:id="@+id/mainImportDataCV"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="15dp"
                        android:gravity="start|center"
                        android:text="导入笔记数据"
                        android:textColor="?attr/myTextColor"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:alpha="0.4"
                        android:background="@color/white" />

                    <!--        导出笔记数据-->
                    <TextView
                        android:id="@+id/mainExportDataTV"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="15dp"
                        android:gravity="start|center"
                        android:text="导出笔记数据"
                        android:textColor="?attr/myTextColor"
                        android:textSize="20sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
