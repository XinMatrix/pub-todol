<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/myBackgroundColor"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="8dp"
        app:cardBackgroundColor="?attr/myFirstColor"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/searchTypeTV"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:background="?attr/mySecondColor"
                android:gravity="center"
                android:padding="2dp"
                android:text="搜索\n笔记"
                android:textColor="?attr/myTextColor" />

            <EditText
                android:id="@+id/searchET"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="Search"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:hint="搜索"
                android:inputType="text"
                android:textColor="?attr/myTextColor"
                android:textColorHint="#B3FFFFFF" />

            <TextView
                android:id="@+id/searchClearTV"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:background="?attr/mySecondColor"
                android:gravity="center"
                android:padding="2dp"
                android:text="清空\n内容"
                android:textColor="?attr/myTextColor" />

            <LinearLayout
                android:layout_width="2dp"
                android:layout_height="match_parent"
                tools:ignore="UselessLeaf" />

            <TextView
                android:id="@+id/searchRandomTV"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:background="?attr/mySecondColor"
                android:gravity="center"
                android:padding="2dp"
                android:text="随机\n搜索"
                android:textColor="?attr/myTextColor" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchRV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

</LinearLayout>