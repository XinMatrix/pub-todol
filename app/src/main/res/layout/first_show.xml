<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/firstShowLL"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:baselineAligned="false"
    android:gravity="center"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <TextView
            android:id="@+id/firstShowTimeTV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Date Here"
            android:textColor="?attr/myTextColor"
            android:textSize="20sp" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="30dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:background="?attr/myFirstColor" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true"
            android:contentDescription=""
            android:src="@drawable/circle" />

        <LinearLayout
            android:id="@+id/firstShowStartEndLL"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_alignParentBottom="true"
            android:background="?attr/myFirstColor"
            android:orientation="horizontal" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/firstShowNumberTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Number Here"
            android:textColor="?attr/myTextColor"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/firstShowContentTV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp"
            android:text="FirstContent Here"
            android:textColor="?attr/myTextColor"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>