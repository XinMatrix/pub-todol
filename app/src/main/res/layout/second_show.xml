<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/secondShowLL"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="40dp"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/secondShowCV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:minHeight="40dp"
        app:cardBackgroundColor="?attr/myFirstColor"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/secondStarCV"
                android:layout_width="10dp"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="5dp" />

            <ImageView
                android:id="@+id/secondFileIV"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_margin="5dp"
                android:contentDescription="File"
                android:padding="5dp"
                android:src="@drawable/ic_next"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/secondShowContentTV"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:text="Content Here"
                    android:textColor="?attr/myTextColor"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/secondShowPlaceTV"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:text="Place Here"
                    android:textColor="?attr/myTextColor"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:alpha="0.4"
                android:background="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/secondShowStartTimeTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:text="StartTime Here"
                    android:textColor="?attr/myTextColor"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/secondShowSpendTimeTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:minHeight="20dp"
                    android:text="DuringTime Here"
                    android:textColor="?attr/myTextColor"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/secondShowChildLL"
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?attr/mySecondColor"
            android:visibility="gone"
            android:orientation="horizontal" />

    </androidx.cardview.widget.CardView>

</LinearLayout>