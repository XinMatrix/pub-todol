<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/myFirstColor"
        app:cardCornerRadius="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/myDialogCheckFileTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="15dp"
                android:text="查看附件"
                android:textColor="?attr/myTextColor"
                android:textSize="25sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/myDialogCheckFileLL"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:alpha="0.4"
                android:background="@color/white"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/myDialogButtonSaveToClipBoardTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="15dp"
                android:text="复制内容"
                android:textColor="?attr/myTextColor"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:alpha="0.4"
                android:background="@color/white" />

            <TextView
                android:id="@+id/myDialogDeleteFileTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="15dp"
                android:text="删除附件"
                android:textColor="?attr/myTextColor"
                android:textSize="25sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/myDialogButtonStarTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="15dp"
                android:text="收藏笔记"
                android:textColor="?attr/myTextColor"
                android:textSize="25sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:alpha="0.4"
                android:background="@color/white"
                android:orientation="horizontal"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/myDialogDeleteFileLL"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:alpha="0.4"
                android:background="@color/white"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/myDialogButtonDeleteTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="15dp"
                android:text="删除笔记"
                android:textColor="?attr/myTextColor"
                android:textSize="25sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>